# ============================================================
# 环境变量模板：复制为 .env 后填入真实值（.env 已被 gitignore）
#   cp .env.example .env
#
# 注入路径速查：
#   本地开发   -> 应用直接读取 .env（pydantic-settings）
#   Docker Compose -> compose 读取 .env 后注入容器
#   Kubernetes -> 非敏感项放 ConfigMap，LLM_API_KEY 放 Secret
#   Helm       -> values.yaml + --set llm.apiKey=xxx
# ============================================================

# 环境标识：dev / test / prod（决定日志级别等行为）
APP_ENV=dev

# 时区：/api/node/time 接口使用
TZ=Asia/Shanghai

# ---- LLM 配置（OpenAI 兼容协议）----
# Base URL 示例（任选其一）：
#   OpenAI     : https://api.openai.com/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   通义千问   : https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# API Key（敏感信息）：在 .env 中填写真实值，不要提交到 git
LLM_API_KEY=sk-your-api-key-here

# 默认模型：LLM_MODEL 与上游服务支持的模型名保持一致
LLM_MODEL=gpt-4o-mini

# 请求超时（秒）
LLM_TIMEOUT=60
